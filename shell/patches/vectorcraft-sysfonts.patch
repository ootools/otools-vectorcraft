 /// The installed fonts by ASCII-lowercased family name (lookups ignore ASCII case, as
-/// [`FontDb::face`] does). Always empty on wasm, which has no system fonts.
+/// [`FontDb::face`] does). On wasm it holds the fonts the host listed ([`FontDb::set_system_catalog`]),
+/// as the wasm build has no font folder to scan.
 type Catalog = HashMap<String, CatalogFamily>;
 
+/// One face of a system font the host listed for the wasm build
+/// ([`FontDb::set_system_catalog`]): the family and style its `name` table declares, and the
+/// file to read it from. The wasm build has no font folder to scan: the plugin shell reads
+/// the bytes through the host and adds them with [`FontDb::add_font`]; until then the family
+/// is listed in the menus and resolves to the fallback face.
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Debug)]
+pub struct SystemFont {
+    pub family: String,
+    pub style: String,
+    pub path: String,
+    /// Weight and italic as the style lists show them (from the style's name).
+    pub weight: f32,
+    pub italic: bool,
+}
+
+/// The families asked for but not loaded yet (wasm only): the shell reads their files through
+/// the host and adds the faces, after which the lookup finds them.
+#[cfg(target_arch = "wasm32")]
+static PENDING_FONTS: std::sync::Mutex<Vec<String>> = std::sync::Mutex::new(Vec::new());
+
+/// The system font families asked for since the last call, not loaded yet (wasm only): the
+/// shell reads their files through the host and adds them. Empty without a host font bridge
+/// (a plain browser build).
+#[cfg(target_arch = "wasm32")]
+pub fn take_pending_fonts() -> Vec<String> {
+    std::mem::take(&mut *PENDING_FONTS.lock().unwrap_or_else(|e| e.into_inner()))
+}
