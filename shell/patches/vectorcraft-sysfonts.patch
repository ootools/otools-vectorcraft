+    /// Catalog the system fonts the host listed (wasm only, where there is no font folder to
+    /// scan). The menus list them at once; a lookup asking for one of them
+    /// ([`FontDb::face`]) queues its family, whose files the plugin shell then reads through
+    /// the host and adds with [`FontDb::add_font`].
+    #[cfg(target_arch = "wasm32")]
+    pub fn set_system_catalog(&self, fonts: Vec<SystemFont>) {
+        let mut catalog = Catalog::new();
+        for f in fonts {
+            let entry = catalog.entry(f.family.to_ascii_lowercase()).or_insert_with(|| CatalogFamily {
+                name: f.family.clone(),
+                native: None,
+                faces: Vec::new(),
+                traits: None,
+            });
+            let path = std::path::Path::new(&f.path);
+            if entry.faces.iter().any(|cf| cf.style.eq_ignore_ascii_case(&f.style) && cf.path == path) {
+                continue;
+            }
+            entry.faces.push(CatalogFace { style: f.style, path: path.to_path_buf(), weight: f.weight, italic: f.italic });
+        }
+        *self.catalog.write().unwrap_or_else(|e| e.into_inner()) = catalog;
+        self.changed();
+    }
